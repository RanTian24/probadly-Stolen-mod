# preview.psui — 排版预览台 (机器绑定面板, 图元树后端)
# v0.5.0: grid_slot 7x5(用户实测舱形); 预设按钮=基础/扩展/自定义(元素树不变, 旧存档槽位请先「清空预览」)
# 形状预设可切换; shape 串长=35(=7x5), machine_set_shape 硬要求
# v0.4.1: 修复 5 个按钮漏绑 on_click (面板能开但按钮全部无反应的根因)
window preview:
  title: "排版预览台 · Module Bay Preview"
  size: 640x720
  draggable: true
  persistent: true
  on_open: pv_on_open
  spacing: 3

  label lbl_title:
    text: "原生舱位渲染 · 舱=7x5 · 模组按真实占格自动摆放"

  label lbl_status:
    text: "状态: 待生成 (先在F5面板计算一次最优组合)"

  row:
    spacing: 8
    button btn_run:
      text: "生成排版预览"
      on_click: pv_run
    button btn_clear:
      text: "清空预览"
      on_click: pv_clear

  row:
    spacing: 6
    button btn_rect:
      text: "形状:基础"
      on_click: pv_shape
    button btn_furn:
      text: "形状:扩展"
      on_click: pv_shape
    button btn_bay:
      text: "形状:自定义(F7)"
      on_click: pv_shape

  label lbl_shape:
    text: "当前形状: 基础舱形(中心十字洞)"

  label lbl_hint:
    text: "预览件已锁定不可取; 清空预览=销毁预览件"

  grid_slot pv_bay:
    whitelist: ["module_planner:__reserved"]
    size: 7x5
    on_change: pv_changed
